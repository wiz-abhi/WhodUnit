                      },
                      {
                        "type": "builder_trace_operator",
                        "spec": {
                          "name": "T1",
                          "expression": "(A => B) && NOT C",
                          "returnSpansFrom": "A",
                          "aggregations": [
                            {
                              "expression": "count_distinct(trace_id)"
                            }
                          ],
                          "stepInterval": 0,
                          "disabled": false
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "ADenom",
                          "signal": "traces",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "expression": "count_distinct(trace_id)"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment = 'whodunit-demo' AND service.name = 'shop-payment'"
                          },
                          "disabled": false
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "T1 / ADenom"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "2": {
