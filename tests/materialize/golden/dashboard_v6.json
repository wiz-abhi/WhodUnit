                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "C",
                          "signal": "traces",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment = 'whodunit-demo' AND service.name = 'shop-flag-service'"
                          },
                          "disabled": false
