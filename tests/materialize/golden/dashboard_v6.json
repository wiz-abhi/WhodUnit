{
  "schemaVersion": "v6",
  "name": "whodunit-a-b-not-c",
  "spec": {
    "display": {
      "name": "Whodunit \u2014 (A => B) && NOT C"
    },
    "variables": [],
    "panels": {
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Matching traces over time",
            "description": "count_distinct(trace_id) of (A => B) && NOT C"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment = 'whodunit-demo' AND service.name = 'shop-payment'"
                          },
                          "disabled": false
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "traces",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment = 'whodunit-demo' AND name = 'redis-retry'"
                          },
                          "disabled": false
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "C",
                          "signal": "traces",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment = 'whodunit-demo' AND service.name = 'shop-flag-service'"
                          },
                          "disabled": false
                        }
                      },
                      {
                        "type": "builder_trace_operator",
                        "spec": {
                          "name": "T1",
                          "expression": "(A => B) && NOT C",
                          "returnSpansFrom": "A",
                          "aggregations": [
                            {
                              "expression": "count_distinct(trace_id)"
                            }
                          ],
                          "stepInterval": 0,
                          "disabled": false
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Share of traffic",
            "description": "operator matches / anchor traffic (F1)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {}
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
